# GuardOps Environment Variables
# Copy to .env and fill values. Never commit .env to git.

# AWS credentials (Phase 2+)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# Container Registry (Phase 2+)
ECR_REGISTRY=

# Security tools (Phase 2+)
SEMGREP_APP_TOKEN=
SONAR_TOKEN=
SONAR_HOST_URL=https://sonarcloud.io

# Monitoring (Phase 5+)
GRAFANA_URL=
PROMETHEUS_URL=
LOKI_URL=

# Notifications (Phase 5+)
SLACK_WEBHOOK_URL=
ALERT_EMAIL=admin@example.com

# GuardOps
GUARDOPS_S3_BUCKET=guardops-reports
GUARDOPS_LOG_LEVEL=INFO