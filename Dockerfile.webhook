FROM 236796665744.dkr.ecr.ap-south-1.amazonaws.com/guardops-app:latest

USER root

# Install kubectl v1.28 (v1.29 removed --short flag used by readyz probe)
RUN apt-get update -qq && apt-get install -y -qq curl ca-certificates && \
    curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && mv kubectl /usr/local/bin/kubectl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN /venv/bin/python -m pip install --quiet \
    fastapi==0.111.0 \
    uvicorn==0.30.1 \
    pyyaml==6.0.1 \
    httpx==0.27.0 \
    kubernetes==30.1.0

COPY backend/ /app/backend/

WORKDIR /app
USER 10001
EXPOSE 9095

CMD ["/venv/bin/python", "-m", "uvicorn", "backend.security.alertmanager_handler:app", "--host", "0.0.0.0", "--port", "9095", "--workers", "1", "--log-level", "info"]
