FROM 236796665744.dkr.ecr.ap-south-1.amazonaws.com/guardops-app:latest

USER root

# Install kubectl v1.28 (v1.29 removed --short flag used by readyz probe)
RUN apt-get update -qq && apt-get install -y -qq curl ca-certificates && \
    curl -LO "https://dl.k8s.io/release/v1.28.0/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && mv kubectl /usr/local/bin/kubectl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# fastapi>=0.136 + starlette 1.2.x clears the Starlette CVEs (kept in sync with
# pyproject [dashboard] and Dockerfile.dashboard).
# Install everything the webhook needs. The base app image may not carry the GuardOps
# CLI deps and strips pip from its venv (CVE-clean for the Trivy gate), so bootstrap
# pip (curl installed above), then install the core CLI deps it imports via cli.utils.*
# (rich/click/pyyaml/requests/boto3/dotenv) plus the webhook's own extras.
RUN curl -fsSL --retry 5 --retry-all-errors --retry-delay 3 --connect-timeout 30 \
        https://bootstrap.pypa.io/get-pip.py -o /tmp/get-pip.py && \
    /venv/bin/python /tmp/get-pip.py --quiet && \
    rm -f /tmp/get-pip.py && \
    /venv/bin/python -m pip install --quiet \
        "click>=8.1.7" "rich>=13.7,<14.0" "requests>=2.31" \
        "boto3>=1.34" "python-dotenv>=1.0" \
        "fastapi>=0.136,<0.137" \
        "starlette>=1.2,<1.3" \
        "uvicorn>=0.30" \
        pyyaml==6.0.1 \
        httpx==0.27.0 \
        kubernetes==30.1.0

COPY backend/ /app/backend/

WORKDIR /app
USER 10001
EXPOSE 9095

CMD ["/venv/bin/python", "-m", "uvicorn", "backend.security.alertmanager_handler:app", "--host", "0.0.0.0", "--port", "9095", "--workers", "1", "--log-level", "info"]
