# URL of the GuardOps dashboard API backend
# Local:      http://localhost:8081
# Production: https://app.guardops.live
VITE_API_URL=http://localhost:8081

# Public URL of the static dashboard snapshot (written by
# `guardops dashboard snapshot --to-s3`). When the live API above is unreachable
# — e.g. the EKS cluster is torn down overnight — the SPA falls back to this so the
# site keeps rendering last-known data from any device, with an "offline" banner.
# Leave empty to disable the fallback (the dashboard then errors when the API is down).
# Production example: https://guardops-reports-xxxx.s3.amazonaws.com/dashboard/snapshot.json
VITE_SNAPSHOT_URL=

# Auth token — format:
#   "user:password"  for Basic auth  (GUARDOPS_DASHBOARD_AUTH_MODE=basic)
#   "rawtoken"       for Bearer auth (GUARDOPS_DASHBOARD_AUTH_MODE=token)
# Leave empty if GUARDOPS_DASHBOARD_AUTH_MODE=none (local dev without auth)
VITE_API_TOKEN=
