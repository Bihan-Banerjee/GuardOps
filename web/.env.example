# URL of the GuardOps dashboard API backend
# Local:      http://localhost:8081
# Production: https://app.guardops.live
VITE_API_URL=http://localhost:8081

# Auth token — format:
#   "user:password"  for Basic auth  (GUARDOPS_DASHBOARD_AUTH_MODE=basic)
#   "rawtoken"       for Bearer auth (GUARDOPS_DASHBOARD_AUTH_MODE=token)
# Leave empty if GUARDOPS_DASHBOARD_AUTH_MODE=none (local dev without auth)
VITE_API_TOKEN=
