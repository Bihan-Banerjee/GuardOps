# infra/terraform/terraform.tfvars.example
# Copy to terraform.tfvars and fill in. Never commit terraform.tfvars.

aws_account_id = "236796665744"   # your account ID
aws_region     = "ap-south-1"
project_name   = "guardops"
environment    = "prod"

ecr_image_names    = ["guardops-app"]
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b"]

# EKS cost controls
node_instance_type     = "t3.medium"
node_min_size          = 1
node_max_size          = 1
node_desired_size      = 1
enable_cloudwatch_logs = false

# GitHub OIDC (Phase 6) — owner/name of the repo allowed to assume the CI role
github_repo = "Bihan-Banerjee/GuardOps"

# ── Phase 10: DNS + TLS + ArgoCD ──────────────────────────────────────────────
# Set enable_dns_tls = true to provision the Route53 zone, cert-manager, and the
# AWS Load Balancer Controller. Apply in two steps (see FIRST APPLY in main.tf):
#   1. First apply with alb_dns_name = "" to create the zone + cert-manager.
#   2. After `guardops deploy` provisions the ALB, set alb_dns_name and re-apply
#      to create the apex/staging/argocd Route53 alias records.
# alb_controller_role_arn is the IRSA role morning-start.ps1 creates
# (guardops-alb-controller). Swap the account ID for yours.
enable_dns_tls          = true
domain_name             = "guardops.live"
alb_controller_role_arn = "arn:aws:iam::236796665744:role/guardops-alb-controller"
alb_dns_name            = ""        # leave empty on first apply
enable_argocd           = true
git_repo_url            = "https://github.com/Bihan-Banerjee/GuardOps"

# ── Phase 11: Admission control (Kyverno) ─────────────────────────────────────
# Set enable_kyverno = true to install Kyverno + the IRSA role that lets it read
# cosign signatures from private ECR. Apply with -target=module.kyverno, then run
# scripts/setup-admission-control.ps1 to apply the ClusterPolicies.
# Start with Audit (record only); flip to Enforce once the PolicyReports are clean
# (kyverno_policy_action = "Enforce" or scripts/setup-admission-control.ps1 -Enforce).
enable_kyverno        = true
kyverno_policy_action = "Audit"
